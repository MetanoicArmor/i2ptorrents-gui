# Ubuntu 24.04 (noble): glibc 2.39 baseline for Linux release bundles.
FROM ubuntu:24.04

ENV DEBIAN_FRONTEND=noninteractive \
    LC_ALL=C.UTF-8 \
    LANG=C.UTF-8 \
    QT_QPA_PLATFORM=offscreen \
    APPIMAGE_EXTRACT_AND_RUN=1

RUN apt-get update -qq \
    && apt-get install -y --no-install-recommends \
        ca-certificates \
        curl \
        wget \
        git \
        unzip \
        zip \
        file \
        patchelf \
        desktop-file-utils \
        build-essential \
        pkg-config \
        cmake \
        libclang-dev \
        qt6-base-dev \
        qt6-base-dev-tools \
        qt6-tools-dev \
        libgl-dev \
        libegl1 \
        libglib2.0-0 \
        libfuse2t64 \
        fuse3 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /src
CMD ["./build-linux.sh"]

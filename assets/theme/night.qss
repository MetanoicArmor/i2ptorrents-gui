
QMainWindow, QWidget#MainWindow { background: #1c1c1e; }
QDialog { background: transparent; }
QWidget { color: #f5f5f7; font-size: 13px; }
QFrame#Sidebar, QWidget#Sidebar {
    background: transparent; border: none;
}
QFrame#Surface, QWidget#Surface {
    background: #1c1c1e; border: none;
}
QWidget#PaneSplit { background: #3d3d3f; border: none; max-width: 1px; }
QFrame#TorrentCard, QFrame#SummaryCard, QWidget#TorrentCard, QWidget#SummaryCard {
    background: #2c2c2e; border: none; border-radius: 10px;
}
QLabel#AppTitle { font-size: 20px; font-weight: 600; }
QLabel#AppSubtitle { color: #9aa3b5; font-size: 13px; padding: 0px; }
QLabel#Title { color: #f5f5f7; font-size: 22px; font-weight: 600; }
QLabel#SectionTitle { color: #9aa3b5; font-size: 12px; font-weight: 600; }
QLabel#TorrentName { color: #f5f5f7; font-size: 14px; font-weight: 600; padding: 0px; }
QLabel#Secondary, QLabel#PeersLink, QLabel#StatusText { color: #9aa3b5; font-size: 12px; padding: 0px; }
QLabel#StatusOnline { color: #a9dfb9; background: #223c2b; border-radius: 10px; padding: 6px 12px; }
QLabel#StatusOffline { color: #f0aaa5; background: #472c2d; border-radius: 10px; padding: 6px 12px; }
QPushButton, QToolButton {
    background: #3a3a3c; border: none; border-radius: 8px; padding: 8px 14px; color: #ffffff;
}
QPushButton:hover, QToolButton:hover { background: #30333c; }
QPushButton:pressed, QToolButton:pressed { background: #393d48; }
QPushButton#Primary { background: #0a84ff; color: #ffffff; }
QPushButton#Primary:hover { background: #2d95ff; }
QPushButton#Danger { background: #2a2d36; color: #f0aaa5; }
QPushButton#Filter { text-align: left; background: transparent; color: #ffffff; padding: 6px 10px; border-radius: 6px; }
QPushButton#Filter:hover { background: rgba(255, 255, 255, 0.08); }
QPushButton#Filter:checked, QPushButton#FilterOn { background: rgba(255, 255, 255, 0.16); color: #ffffff; font-weight: 600; }
QPushButton#AboutButton, QPushButton#SettingsButton {
    text-align: left; background: transparent; color: #ffffff; padding: 6px 10px; border-radius: 6px;
}
QPushButton#AboutButton:hover, QPushButton#SettingsButton:hover { background: rgba(255, 255, 255, 0.08); }
QLineEdit, QSpinBox, QComboBox {
    background: #3a3a3c; border: none; border-radius: 8px;
    padding: 6px 12px; min-height: 22px;
}
QComboBox:hover { background: #48484a; }
QLineEdit:focus, QSpinBox:focus, QComboBox:focus { border: none; }
QFrame#SpinRow, QFrame#PathRow {
    background: #3a3a3c; border: 1px solid transparent; border-radius: 8px;
}
QFrame#SpinRow[focused="true"] { border: 1px solid #0a84ff; }
QFrame#SpinRow QSpinBox, QFrame#PathRow QLineEdit {
    background: transparent; border: none; padding: 0px 12px; min-height: 0px;
    selection-background-color: #0a84ff; selection-color: #ffffff;
}
QFrame#PathRow QLineEdit#ReadOnlyPath {
    color: #a1a1a6;
}
QFrame#SpinRow QSpinBox:focus, QFrame#PathRow QLineEdit:focus { border: none; }
QWidget#SpinStepColumn {
    background: transparent; border: none;
    border-top-right-radius: 7px; border-bottom-right-radius: 7px;
}
QToolButton#SpinStepUp, QToolButton#SpinStepDown {
    border: none; background: transparent; color: #a1a1a6;
    font-size: 11px; min-width: 22px; max-width: 22px; min-height: 16px; padding: 0px;
}
QToolButton#SpinStepUp { border-top-right-radius: 7px; }
QToolButton#SpinStepDown { border-bottom-right-radius: 7px; }
QToolButton#SpinStepUp:hover, QToolButton#SpinStepDown:hover {
    background: rgba(255, 255, 255, 0.10); color: #f5f5f7;
}
QToolButton#SpinStepUp:pressed, QToolButton#SpinStepDown:pressed {
    background: rgba(255, 255, 255, 0.16);
}
QComboBox::drop-down {
    subcontrol-origin: padding; subcontrol-position: center right;
    width: 28px; border: none; background: transparent;
}
QComboBox::down-arrow { image: none; width: 0; height: 0; }
QComboBox QAbstractItemView {
    background: transparent; color: #f5f5f7; border: none; outline: none;
    selection-background-color: #3a3a3c; selection-color: #f5f5f7;
}
QComboBoxPrivateContainer {
    background: transparent; border: none; border-radius: 0px; padding: 0px;
}
QProgressBar { background: #3b3e48; border: none; border-radius: 3px; min-height: 7px; max-height: 7px; text-align: center; }
QProgressBar::chunk { background: #0a84ff; border-radius: 3px; }
QToolButton#MoreButton {
    padding: 2px 8px; min-width: 24px; max-height: 22px; font-size: 11px; border-radius: 6px;
}
QMenu {
    background: rgba(44, 44, 46, 0.74); color: #f5f5f7; border: 1px solid rgba(72, 72, 74, 0.52);
    padding: 8px; border-radius: 14px;
}
QMenu::item {
    background: transparent; color: #f5f5f7; padding: 9px 14px; border-radius: 9px;
}
QMenu::item:selected { background: #3a3a3c; }
QMenu::item:disabled { color: #8e8e93; }
QMenu::separator { height: 1px; background: #48484a; margin: 6px 8px; }
QScrollArea { border: none; background: transparent; }
QScrollArea > QWidget > QWidget { background: transparent; }
QScrollBar:vertical {
    background: transparent; width: 6px; margin: 2px 0px 2px 0px;
}
QScrollBar::handle:vertical {
    background: rgba(255, 255, 255, 0.20); min-height: 24px; border-radius: 3px;
}
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical { height: 0; }
QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical { background: transparent; }
QCheckBox { spacing: 8px; }
QWidget#FilesTablePane, QWidget#PeersTablePane, QWidget#TrackersTablePane {
    background: #1c1c1e; border: none; border-radius: 12px;
}
QWidget#FilesTableOverlay { background: transparent; border: none; }
QTableWidget#FilesTable, QTableWidget#PeersTable, QTableWidget#TrackersTable {
    background: #2c2c2e; border: none; border-radius: 12px;
    gridline-color: transparent; outline: 0;
    alternate-background-color: #3d3d40;
}
QTableWidget#FilesTable::viewport, QTableWidget#PeersTable::viewport, QTableWidget#TrackersTable::viewport {
    background: transparent; border: none;
    border-bottom-left-radius: 12px; border-bottom-right-radius: 12px;
}
QTableWidget#FilesTable::item {
    padding: 0px; border: none; color: #f5f5f7; background: transparent;
}
QTableWidget#PeersTable::item, QTableWidget#TrackersTable::item {
    padding: 6px 8px; border: none; color: #f5f5f7; background: transparent;
}
QTableWidget#FilesTable QLabel#FilesName {
    background: transparent; color: #f5f5f7;
}
QTableWidget#FilesTable QWidget#FilesPriorityCell {
    background: transparent; border: none;
}
QTableWidget#FilesTable QToolButton#FilesPriority {
    background: #48484a; border: none; border-radius: 6px;
    min-width: 0px; padding: 4px 4px; min-height: 22px; color: #f5f5f7;
}
QTableWidget#FilesTable QToolButton#FilesPriority:hover { background: #5a5a5e; }
QTableWidget#FilesTable QToolButton#FilesPriority:disabled { background: #3a3a3c; color: #8e8e93; }
QTableWidget#FilesTable QToolButton#FilesPriority::menu-indicator {
    image: none; width: 0px; height: 0px;
}
QTableWidget#FilesTable QHeaderView {
    background: transparent; border: none;
}
QTableWidget#FilesTable QHeaderView::section {
    background: #252527;
    color: #c7c7cc;
    border: none;
    border-bottom: 1px solid #48484a;
    padding: 8px 8px;
    font-weight: 600; font-size: 12px;
}
QTableWidget#FilesTable QHeaderView::section:first {
    border-top-left-radius: 12px;
}
QTableWidget#FilesTable QHeaderView::section:last {
    border-top-right-radius: 12px;
}
QTableWidget#PeersTable QHeaderView, QTableWidget#TrackersTable QHeaderView {
    background: transparent; border: none;
}
QTableWidget#PeersTable QHeaderView, QTableWidget#TrackersTable QHeaderView::section {
    background: #252527;
    color: #c7c7cc;
    border: none;
    border-bottom: 1px solid #48484a;
    padding: 8px 8px;
    font-weight: 600; font-size: 12px;
}
QTableWidget#PeersTable QHeaderView, QTableWidget#TrackersTable QHeaderView::section:first {
    border-top-left-radius: 12px;
}
QTableWidget#PeersTable QHeaderView, QTableWidget#TrackersTable QHeaderView::section:last {
    border-top-right-radius: 12px;
}

QToolTip {
    background: #2c2c2e; color: #f5f5f7; border: none;
    padding: 6px 10px; border-radius: 8px;
}
QLabel#AboutLink { color: #9aa3b5; font-size: 12px; padding: 0px; }
QLabel#AboutLink a, QLabel#AboutLink a:link, QLabel#AboutLink a:visited, QLabel#AboutLink a:hover {
    color: #9aa3b5;
    text-decoration: underline;
}

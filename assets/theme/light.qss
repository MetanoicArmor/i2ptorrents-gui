
QMainWindow, QWidget#MainWindow { background: #ffffff; }
QDialog { background: transparent; }
QWidget { color: #1d1d1f; font-family: "Inter"; font-size: 13px; }
QFrame#Sidebar, QWidget#Sidebar {
    background: transparent; border: none;
}
QFrame#Surface, QWidget#Surface {
    background: #ffffff; border: none;
}
QWidget#PaneSplit { background: #d8d8dc; border: none; max-width: 1px; }
QFrame#TorrentCard, QFrame#SummaryCard, QWidget#TorrentCard, QWidget#SummaryCard {
    background: #f2f2f7; border: none; border-radius: 10px;
}
QLabel#AppTitle { font-size: 20px; font-weight: 650; }
QLabel#AppSubtitle { color: #626875; font-size: 13px; padding: 0px; }
QLabel#Title { color: #1d1d1f; font-size: 22px; font-weight: 650; }
QLabel#SectionTitle { color: #525966; font-size: 12px; font-weight: 600; }
QLabel#TorrentName { color: #1d1d1f; font-size: 14px; font-weight: 650; padding: 0px; }
QLabel#Secondary, QLabel#StatusText { color: #626875; font-size: 12px; padding: 0px; }
QLabel#StatusOnline { color: #245039; background: #d7ebdc; border-radius: 10px; padding: 6px 12px; }
QLabel#StatusOffline { color: #7c302c; background: #f2d8d7; border-radius: 10px; padding: 6px 12px; }
QPushButton, QToolButton {
    background: #f8f9fc; border: none; border-radius: 9px; padding: 8px 14px; color: #20232b;
}
QPushButton:hover, QToolButton:hover { background: #ffffff; }
QPushButton:pressed, QToolButton:pressed { background: #e4e9f2; }
QPushButton#Primary { background: #0a84ff; color: #ffffff; }
QPushButton#Primary:hover { background: #2d95ff; }
QPushButton#Danger { background: #e6ebf3; color: #b94b45; }
QPushButton#Filter { text-align: left; background: transparent; color: #1d1d1f; padding: 6px 10px; border-radius: 6px; }
QPushButton#Filter:hover { background: rgba(0, 0, 0, 0.06); }
QPushButton#Filter:checked, QPushButton#FilterOn { background: rgba(0, 0, 0, 0.10); color: #1d1d1f; font-weight: 600; }
QPushButton#AboutButton, QPushButton#SettingsButton {
    text-align: left; background: transparent; color: #1d1d1f; padding: 6px 10px; border-radius: 6px;
}
QPushButton#AboutButton:hover, QPushButton#SettingsButton:hover { background: rgba(0, 0, 0, 0.06); }
QLineEdit, QSpinBox, QComboBox {
    background: #e8e8ed; border: none; border-radius: 8px;
    padding: 6px 12px; min-height: 22px;
}
QComboBox:hover { background: #dedee3; }
QLineEdit:focus, QSpinBox:focus, QComboBox:focus { border: none; }
QFrame#SpinRow, QFrame#PathRow {
    background: #e8e8ed; border: 1px solid transparent; border-radius: 8px;
}
QFrame#SpinRow[focused="true"] { border: 1px solid #0a84ff; }
QFrame#SpinRow QSpinBox, QFrame#PathRow QLineEdit {
    background: transparent; border: none; padding: 0px 12px; min-height: 0px;
    selection-background-color: #0a84ff; selection-color: #ffffff;
}
QFrame#SpinRow QSpinBox:focus, QFrame#PathRow QLineEdit:focus { border: none; }
QWidget#SpinStepColumn {
    background: transparent; border: none;
    border-top-right-radius: 7px; border-bottom-right-radius: 7px;
}
QToolButton#SpinStepUp, QToolButton#SpinStepDown {
    border: none; background: transparent; color: #6e6e73;
    font-size: 11px; min-width: 22px; max-width: 22px; min-height: 16px; padding: 0px;
}
QToolButton#SpinStepUp { border-top-right-radius: 7px; }
QToolButton#SpinStepDown { border-bottom-right-radius: 7px; }
QToolButton#SpinStepUp:hover, QToolButton#SpinStepDown:hover {
    background: rgba(0, 0, 0, 0.06); color: #1d1d1f;
}
QToolButton#SpinStepUp:pressed, QToolButton#SpinStepDown:pressed {
    background: rgba(0, 0, 0, 0.10);
}
QComboBox::drop-down {
    subcontrol-origin: padding; subcontrol-position: center right;
    width: 28px; border: none; background: transparent;
}
QComboBox::down-arrow { image: none; width: 0; height: 0; }
QComboBox QAbstractItemView {
    background: #f6f7fa; color: #1d1d1f; border: none; outline: 0;
    selection-background-color: #e5eaf2; selection-color: #1d1d1f;
}
QComboBoxPrivateContainer {
    background: #f6f7fa; border: 1px solid #d0d0d5; border-radius: 10px; padding: 4px;
}
QProgressBar { background: #d6d7dd; border: none; border-radius: 3px; min-height: 7px; max-height: 7px; text-align: center; }
QProgressBar::chunk { background: #0a84ff; border-radius: 3px; }
QToolButton#MoreButton {
    padding: 2px 8px; min-width: 24px; max-height: 22px; font-size: 11px; border-radius: 6px;
}
QMenu {
    background: rgba(242, 242, 247, 0.74); color: #1d1d1f; border: 1px solid rgba(208, 208, 213, 0.52);
    padding: 8px; border-radius: 14px;
}
QMenu::item {
    background: transparent; color: #1d1d1f; padding: 9px 14px; border-radius: 9px;
}
QMenu::item:selected { background: #e8e8ed; }
QMenu::item:disabled { color: #8e8e93; }
QMenu::separator { height: 1px; background: #d0d0d5; margin: 6px 8px; }
QScrollArea { border: none; background: transparent; }
QScrollArea > QWidget > QWidget { background: transparent; }
QScrollBar:vertical {
    background: transparent; width: 6px; margin: 2px 0px 2px 0px;
}
QScrollBar::handle:vertical {
    background: rgba(60, 60, 67, 0.35); min-height: 24px; border-radius: 3px;
}
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical { height: 0; }
QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical { background: transparent; }
QCheckBox { spacing: 8px; }
QWidget#FilesTablePane {
    background: #ffffff; border: none; border-radius: 0px;
}
QWidget#FilesTableOverlay { background: transparent; border: none; }
QTableWidget#FilesTable {
    background: #f2f2f7; border: 1px solid #d0d0d5; border-radius: 0px;
    gridline-color: transparent; outline: 0;
    alternate-background-color: #e8e8ed;
}
QTableWidget#FilesTable::viewport {
    background: transparent; border: none; border-radius: 0px;
}
QTableWidget#FilesTable::item {
    padding: 0px; border: none; color: #1d1d1f; background: transparent;
}
QTableWidget#FilesTable QLabel#FilesName {
    background: transparent; color: #1d1d1f;
}
QTableWidget#FilesTable QWidget#FilesPriorityCell {
    background: transparent; border: none;
}
QTableWidget#FilesTable QToolButton#FilesPriority {
    background: #ffffff; border: none; border-radius: 6px;
    padding: 4px 10px; min-height: 22px; color: #1d1d1f;
}
QTableWidget#FilesTable QToolButton#FilesPriority:hover { background: #f2f2f7; }
QTableWidget#FilesTable QToolButton#FilesPriority:disabled { background: #e8e8ed; color: #8e8e93; }
QTableWidget#FilesTable QToolButton#FilesPriority::menu-indicator {
    image: none; width: 0px; height: 0px;
}
QTableWidget#FilesTable QHeaderView {
    background: #e8e8ed; border: none;
}
QTableWidget#FilesTable QHeaderView::section {
    background: #e8e8ed; color: #6e6e73;
    border: none; border-right: none; border-radius: 0px;
    border-bottom: 1px solid #d0d0d5; padding: 8px 8px;
    font-weight: 600; font-size: 12px;
}

QToolTip {
    background: #f6f7fa; color: #2c3442; border: none;
    padding: 6px 10px; border-radius: 8px;
}
QLabel#AboutLink, QLabel#AboutLink a { color: #0a84ff; }
